# direnv config — auto-loads dev environment on `cd` into this repo.
# Run `direnv allow` once after cloning.

# Use the Nix flake devShell (Go, gopls, gotools, sqlite, nodejs_22, just, goreleaser).
use flake

# Local overrides — anything you don't want committed (e.g. custom REPLOG_BASE_URL).
# Create .env.local from .env.example and customize as needed.
dotenv_if_exists .env.local
