{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Dev (server + frontend)",
            "type": "shell",
            "command": "just dev",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "Run Server",
            "type": "shell",
            "command": "just dev-backend",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "Vite Dev Server",
            "type": "shell",
            "command": "just dev-frontend",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "go build ./cmd/replog",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$go"],
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "Vet",
            "type": "shell",
            "command": "go vet ./...",
            "group": "build",
            "problemMatcher": ["$go"],
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem"
            }
        },
        {
            "label": "Test All",
            "type": "shell",
            "command": "go test -v -count=1 ./...",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$go"],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Test Current Package",
            "type": "shell",
            "command": "go test -v -count=1 ./${relativeFileDirname}/...",
            "group": "test",
            "problemMatcher": ["$go"],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Quality Gates (build + vet + test)",
            "type": "shell",
            "command": "just qa",
            "group": "build",
            "problemMatcher": ["$go"],
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}
