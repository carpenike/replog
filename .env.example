# RepLog local development environment — copy to .env.local and customize.
#
# Most defaults are good for local dev. The Justfile and VS Code Run Server
# task already set everything you need to boot the app. Only set values here
# if you want to override the defaults or add secrets that should not be
# committed.
#
# .env.local is gitignored. .env.example (this file) is committed.
#
# NOTE: LLM API keys (Anthropic, OpenAI) are NOT environment variables.
# They are stored encrypted in the database via the admin settings UI at
# http://localhost:5173/admin/settings after you log in.

# --- Server ---
# REPLOG_ADDR=:8080
# REPLOG_DB_PATH=./dev.db
# REPLOG_AVATAR_DIR=./avatars

# --- Bootstrap admin (created on first run if no users exist) ---
# REPLOG_ADMIN_USER=admin
# REPLOG_ADMIN_PASS=admin
# REPLOG_ADMIN_EMAIL=admin@localhost

# --- Encryption key for sensitive settings (LLM keys, etc.) ---
# Auto-generated on first run if not set; persisted to the database.
# Override here for reproducible test environments.
# REPLOG_SECRET_KEY=dev-only-secret-key-not-for-prod!

# --- PocketID OIDC (webui login) ---
# RepLog is a PocketID OIDC relying party (ADR 019). OIDC login is enabled
# only when all three of issuer / client ID / secret are set. The redirect
# URL defaults to <base URL>/auth/oidc/callback if not overridden.
# REPLOG_OIDC_ISSUER=https://id.example.com
# REPLOG_OIDC_CLIENT_ID=replog
# REPLOG_OIDC_CLIENT_SECRET=change-me
# REPLOG_OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback

# --- Reverse proxy (production-like local) ---
# REPLOG_BASE_URL=https://replog.example.com
# REPLOG_TRUSTED_PROXIES=127.0.0.1,::1

# --- CORS (only needed if NOT using the Vite proxy in dev) ---
# REPLOG_CORS_ORIGINS=http://localhost:5173
